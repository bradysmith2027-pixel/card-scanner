-- ============================================================================
-- Dreamboat Slabs — Step 5 Backend: Initial Schema
-- ============================================================================
-- Run this in the Supabase dashboard → SQL Editor.
-- Implements the design in "[C] Step 5 Backend Schema Design.md".
--
-- Safe to run on a BLANK database. If tables already exist and you want a
-- clean slate, uncomment the DROP block below FIRST (destroys all data).
-- ============================================================================

-- ---- Optional clean-slate reset (DESTRUCTIVE — uncomment only if intended) --
-- drop table if exists public.status_history cascade;
-- drop table if exists public.card_images cascade;
-- drop table if exists public.cards cascade;
-- drop function if exists public.set_updated_at cascade;
-- ----------------------------------------------------------------------------

-- ============================================================================
-- cards — the core inventory table
-- ============================================================================
create table if not exists public.cards (
    id             uuid primary key default gen_random_uuid(),
    user_id        uuid not null references auth.users (id) on delete cascade,

    -- Free text (NOT an enum) on purpose: a 3rd sports brand or TCG later
    -- must not require a schema migration. Validated at the API layer.
    card_type      text not null,

    -- Text, not numeric: cards print ranges ("2024-25") and formats
    -- ("44/99", "OP01-024", "RC-12") that aren't integers.
    year           text,
    set_name       text,
    card_number    text,
    player_name    text,

    -- Manually picked from a catalog dropdown, never auto-classified.
    variation      text,

    -- Field names OCR flagged as a front/back conflict, surfaced on the
    -- confirmation screen. e.g. {'card_number'}.
    needs_review   text[],

    purchase_price numeric(10,2) not null check (purchase_price >= 0),
    sale_price     numeric(10,2) check (sale_price is null or sale_price >= 0),

    -- Current state. Full history lives in status_history (for hold-time
    -- stats). Validated at the API layer against the allowed set:
    -- in_hand | in_transit | at_grading | traded_away | sold
    status         text not null default 'in_hand',

    ebay_comps_url text,

    created_at     timestamptz not null default now(),
    updated_at     timestamptz not null default now()
);

create index if not exists cards_user_id_idx on public.cards (user_id);
create index if not exists cards_status_idx  on public.cards (user_id, status);

-- ============================================================================
-- card_images — 1..n images per card (Sports = front+back, One Piece = front)
-- ============================================================================
create table if not exists public.card_images (
    id           uuid primary key default gen_random_uuid(),
    card_id      uuid not null references public.cards (id) on delete cascade,
    side         text not null check (side in ('front', 'back')),
    -- Path in the PRIVATE Supabase Storage bucket: {user_id}/{card_id}/{side}.jpg
    -- (never the raw image bytes).
    storage_path text not null,
    created_at   timestamptz not null default now()
);

create index if not exists card_images_card_id_idx on public.card_images (card_id);

-- ============================================================================
-- status_history — append-only audit trail (drives "avg hold time" in P&L)
-- ============================================================================
create table if not exists public.status_history (
    id         uuid primary key default gen_random_uuid(),
    card_id    uuid not null references public.cards (id) on delete cascade,
    status     text not null,
    changed_at timestamptz not null default now()
);

create index if not exists status_history_card_id_idx on public.status_history (card_id);

-- ============================================================================
-- updated_at trigger — Postgres does NOT bump this automatically
-- ============================================================================
create or replace function public.set_updated_at()
returns trigger
language plpgsql
as $$
begin
    new.updated_at = now();
    return new;
end;
$$;

drop trigger if exists cards_set_updated_at on public.cards;
create trigger cards_set_updated_at
    before update on public.cards
    for each row
    execute function public.set_updated_at();

-- ============================================================================
-- Row-Level Security — the real enforcement wall
-- ============================================================================
-- Backend forwards each user's JWT, so auth.uid() = the logged-in user.
-- The service_role key bypasses all of this (used ONLY for ops like pg_dump).

alter table public.cards          enable row level security;
alter table public.card_images    enable row level security;
alter table public.status_history enable row level security;

-- cards: a user sees and touches only their own rows.
drop policy if exists cards_owner_all on public.cards;
create policy cards_owner_all on public.cards
    for all
    using (user_id = auth.uid())
    with check (user_id = auth.uid());

-- card_images: ownership is inherited via the parent card.
drop policy if exists card_images_owner_all on public.card_images;
create policy card_images_owner_all on public.card_images
    for all
    using (
        exists (
            select 1 from public.cards c
            where c.id = card_images.card_id and c.user_id = auth.uid()
        )
    )
    with check (
        exists (
            select 1 from public.cards c
            where c.id = card_images.card_id and c.user_id = auth.uid()
        )
    );

-- status_history: same inherited ownership.
drop policy if exists status_history_owner_all on public.status_history;
create policy status_history_owner_all on public.status_history
    for all
    using (
        exists (
            select 1 from public.cards c
            where c.id = status_history.card_id and c.user_id = auth.uid()
        )
    )
    with check (
        exists (
            select 1 from public.cards c
            where c.id = status_history.card_id and c.user_id = auth.uid()
        )
    );

-- ============================================================================
-- Storage bucket — create separately in the dashboard, NOT here
-- ============================================================================
-- In Supabase dashboard → Storage:
--   1. Create a bucket named "card-images"
--   2. Leave "Public bucket" OFF (private) — a public bucket lets anyone
--      enumerate other users' card photos.
--   3. Add a Storage RLS policy so users only read/write their own folder:
--        bucket_id = 'card-images'
--        AND (storage.foldername(name))[1] = auth.uid()::text
--      (This matches the {user_id}/{card_id}/{side}.jpg path convention.)
--   4. Serve images to the frontend via short-lived SIGNED URLs.
-- ============================================================================
