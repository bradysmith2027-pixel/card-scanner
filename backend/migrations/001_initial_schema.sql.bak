-- Dreamboat Slabs - first version of the database
-- ============================================================================
-- Run this in Supabase -> SQL Editor.
-- (Old version. I ended up building the tables in the dashboard instead.)
--
-- Only run this on an empty database. If the tables already exist and you
-- want to start over, uncomment the DROP block below first (deletes everything).
-- ============================================================================

-- ---- Start over (DELETES EVERYTHING, only uncomment if you mean it) -------
-- drop table if exists public.status_history cascade;
-- drop table if exists public.card_images cascade;
-- drop table if exists public.cards cascade;
-- drop function if exists public.set_updated_at cascade;
-- ----------------------------------------------------------------------------

-- ============================================================================
-- cards: the main inventory table
-- ============================================================================
create table if not exists public.cards (
    id             uuid primary key default gen_random_uuid(),
    user_id        uuid not null references auth.users (id) on delete cascade,

    -- Text instead of a set list on purpose, so adding another brand or TCG
    -- later doesn't need a migration. The API checks it.
    card_type      text not null,

    -- Text, not a number, because cards have things like "2024-25", "44/99",
    -- "OP01-024" and "RC-12".
    year           text,
    set_name       text,
    card_number    text,
    player_name    text,

    -- Picked by hand from a dropdown, never guessed by the scanner.
    variation      text,

    -- Fields where the front and back didn't match, so they show up on the
    -- confirm screen. Like {'card_number'}.
    needs_review   text[],

    purchase_price numeric(10,2) not null check (purchase_price >= 0),
    sale_price     numeric(10,2) check (sale_price is null or sale_price >= 0),

    -- Where the card is right now. The full history is in status_history (for
    -- hold time). The API only allows:
    -- in_hand | in_transit | at_grading | traded_away | sold
    status         text not null default 'in_hand',

    ebay_comps_url text,

    created_at     timestamptz not null default now(),
    updated_at     timestamptz not null default now()
);

create index if not exists cards_user_id_idx on public.cards (user_id);
create index if not exists cards_status_idx  on public.cards (user_id, status);

-- ============================================================================
-- card_images: 1 or more photos per card (sports = front+back, One Piece = front)
-- ============================================================================
create table if not exists public.card_images (
    id           uuid primary key default gen_random_uuid(),
    card_id      uuid not null references public.cards (id) on delete cascade,
    side         text not null check (side in ('front', 'back')),
    -- Path in the private storage bucket: {user_id}/{card_id}/{side}.jpg
    -- (not the actual image).
    storage_path text not null,
    created_at   timestamptz not null default now()
);

create index if not exists card_images_card_id_idx on public.card_images (card_id);

-- ============================================================================
-- status_history: log of every status change (for average hold time on P&L)
-- ============================================================================
create table if not exists public.status_history (
    id         uuid primary key default gen_random_uuid(),
    card_id    uuid not null references public.cards (id) on delete cascade,
    status     text not null,
    changed_at timestamptz not null default now()
);

create index if not exists status_history_card_id_idx on public.status_history (card_id);

-- ============================================================================
-- updated_at trigger, since Postgres doesn't update it on its own
-- ============================================================================
create or replace function public.set_updated_at()
returns trigger
language plpgsql
as $$
begin
    new.updated_at = now();
    return new;
end;
$$;

drop trigger if exists cards_set_updated_at on public.cards;
create trigger cards_set_updated_at
    before update on public.cards
    for each row
    execute function public.set_updated_at();

-- ============================================================================
-- Row Level Security, this is what actually keeps users apart
-- ============================================================================
-- The backend sends each user's token, so auth.uid() = whoever is logged in.
-- The service_role key skips all of this (only for admin stuff like backups).

alter table public.cards          enable row level security;
alter table public.card_images    enable row level security;
alter table public.status_history enable row level security;

-- cards: you only see and change your own cards.
drop policy if exists cards_owner_all on public.cards;
create policy cards_owner_all on public.cards
    for all
    using (user_id = auth.uid())
    with check (user_id = auth.uid());

-- card_images: goes by who owns the card.
drop policy if exists card_images_owner_all on public.card_images;
create policy card_images_owner_all on public.card_images
    for all
    using (
        exists (
            select 1 from public.cards c
            where c.id = card_images.card_id and c.user_id = auth.uid()
        )
    )
    with check (
        exists (
            select 1 from public.cards c
            where c.id = card_images.card_id and c.user_id = auth.uid()
        )
    );

-- status_history: same, goes by who owns the card.
drop policy if exists status_history_owner_all on public.status_history;
create policy status_history_owner_all on public.status_history
    for all
    using (
        exists (
            select 1 from public.cards c
            where c.id = status_history.card_id and c.user_id = auth.uid()
        )
    )
    with check (
        exists (
            select 1 from public.cards c
            where c.id = status_history.card_id and c.user_id = auth.uid()
        )
    );

