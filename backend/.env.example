# ============================================================================
# Dreamboat Slabs backend — environment variables
# ============================================================================
# Copy this file to `.env` (which is gitignored) and fill in real values,
# OR set these as system env vars. NEVER commit real values.
#
# Get the Supabase values from: dashboard → Settings → API
# ============================================================================

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Anon (public) key — respects RLS. Safe for the browser. Used for
# per-user requests where the backend forwards the user's JWT.
SUPABASE_ANON_KEY=

# Service role key — BYPASSES RLS (god mode). Treat like a root password.
# Used ONLY for admin/ops jobs (e.g. pg_dump), never for user requests.
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret for verifying Supabase-issued access tokens.
# dashboard → Settings → API → JWT Settings → "JWT Secret".
SUPABASE_JWT_SECRET=

# Already used by the card-scanning pipeline (card_vision.py / ocr_card.py):
ROBOFLOW_API_KEY=
OPENAI_API_KEY=

# Comma-separated list of allowed frontend origins for CORS.
# e.g. https://dreamboatslabs.xyz,http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:5173

# Comma-separated access allowlist — only these emails may use the API.
#
# ⚠️ FAIL-CLOSED: if this is empty, ALL authenticated requests are rejected
# with 403 unless ALLOW_OPEN_ACCESS=true is also set. A valid Supabase token is
# NOT enough on its own — signup is public and Google SSO issues usable tokens
# instantly, so without this allowlist "authenticated" means "any stranger."
ALLOWED_EMAILS=

# Set to true ONLY to deliberately run open/multi-tenant (any signed-in user).
# Ignored whenever ALLOWED_EMAILS is non-empty.
ALLOW_OPEN_ACCESS=false

# Serve interactive API docs at /docs, /redoc, /openapi.json.
# Default false. Keep false in production — it publishes the whole API surface.
ENABLE_DOCS=false

